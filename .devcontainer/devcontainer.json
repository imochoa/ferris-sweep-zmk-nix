// https://github.com/zmkfirmware/zmk#
{
  "name": "ZMK Development",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile",
    "args": {
      "BASE_IMAGE": "docker.io/zmkfirmware/zmk-dev-arm",
      "BASE_TAG": "3.5"
      // "BASE_TAG": "4.1"
    }
  },
  // "runArgs": [
  //   "--userns=keep-id",
  //   "--security-opt",
  //   "label=disable"
  // ],
  // Rootless podman
  // "updateRemoteUserUID": true,
  "containerEnv": {
    "CMAKE_PREFIX_PATH": "/workspaces/ferris-zmk/zephyr",
    "Zephyr_DIR": "/workspaces/ferris-zmk/zephyr/share/zephyr-package/cmake"
  },
  "postAttachCommand": "./.devcontainer/scripts/postAttachCommand.sh",
  "mounts": [
    // "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/ubuntu/.ssh,type=bind,consistency=cached",
    // podman volume create --uid 1000 --gid 1000 zmk-repo-home
    "source=zmk-repo-home,target=/home/ubuntu,type=volume,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/.bashrc,target=/home/ubuntu/.bashrc,type=bind,consistency=cached"
    // TODO: home 
    // "type=bind,source=${localWorkspaceFolder}/.home,target=/home/ubuntu"
    // Permission errors...
    // "type=bind,source=/tmp/ssh-agent.sock,target=/ssh-agent,idmap=true"
    // "type=bind,source=/tmp/ssh-agent.sock,target=/ssh-agent,rw=true"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        // ZMK
        "spadin.zmk-tools",
        "plorefice.devicetree",
        "legale.dts-formatter", // Does not work...
        "trond-snekvik.kconfig-lang", // Kconfig language support
        // C/C++
        "ms-vscode.cpptools",
        // ms-vscode.cpptools-extension-pack
        "usernamehw.errorlens",
        "skellock.just",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[dts]": {
          // "editor.formatOnSave": false
          //   "editor.defaultFormatter": "legale.dts-formatter"
        },
        "files.associations": {
          "*.keymap": "dts",
          "*.just": "just",
          "*.overlay": "dts",
          "*.conf": "properties"
        },
        "terminal.integrated.shell.linux": "/bin/bash",
        // Ext: redhat.vscode-yaml
        "redhat.telemetry.enabled": false
      }
    }
  }
}
